    "Default engine. MNN ships on-device models (RetinaFace + 2d106); MediaPipe needs a downloaded model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default engine. MNN ships on-device models (RetinaFace + 2d106); MediaPipe needs a downloaded model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认引擎。MNN 内置端侧模型（RetinaFace + 2d106）；MediaPipe 需下载模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設引擎。MNN 內建端側模型（RetinaFace + 2d106）；MediaPipe 需下載模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor predeterminado. MNN incluye modelos en el dispositivo (RetinaFace + 2d106); MediaPipe requiere un modelo descargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moteur par défaut. MNN intègre des modèles sur l'appareil (RetinaFace + 2d106) ; MediaPipe nécessite un modèle téléchargé."
          }
        }
      }
    },
