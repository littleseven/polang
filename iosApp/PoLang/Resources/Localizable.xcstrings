    "Photos, beauty filters, facial keypoints, OCR text, media location, and chat memory are all processed locally on your device and are never uploaded to a server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, beauty filters, facial keypoints, OCR text, media location, and chat memory are all processed locally on your device and are never uploaded to a server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、美颜滤镜、人脸关键点、OCR 文字、媒体位置和聊天记忆全部在设备本地处理，绝不上传至服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、美顏濾鏡、人臉關鍵點、OCR 文字、媒體位置和聊天記憶全部在裝置本機處理，絕不上傳伺服器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos, los filtros de belleza, los puntos clave faciales, el texto OCR, la ubicación de los medios y la memoria del chat se procesan de forma local en tu dispositivo y nunca se suben a un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos, filtres d'embellissement, points clés du visage, texte OCR, emplacement des médias et mémoire de conversation sont tous traités localement sur votre appareil et ne sont jamais envoyés vers un serveur."
          }
        }
      }
    },
    "Pick on-device face-detection, tagging and voice models.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick on-device face-detection, tagging and voice models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择端侧人脸检测、打标、语音模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇端側人臉偵測、打標、語音模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige modelos de detección de rostros, etiquetado y voz en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les modèles sur l'appareil pour la détection de visages, l'étiquetage et la voix."
          }
        }
      }
    },
