    "Warp strength magnifies the slim delta. 1.0 = default (subtle); raise it to test if slim is too weak to see.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warp strength magnifies the slim delta. 1.0 = default (subtle); raise it to test if slim is too weak to see."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形变强度放大瘦脸位移。1.0=默认（较微弱）；调高可测试瘦脸是否因强度不足而不可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "形變強度放大瘦臉位移。1.0=預設（較微弱）；調高可測試瘦臉是否因強度不足而不可見。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intensidad del warp amplía el delta de adelgazamiento. 1.0 = valor predeterminado (sutil); súbelo para probar si el adelgazamiento es demasiado leve para notarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La force de déformation amplifie l'effet d'amincissement. 1.0 = valeur par défaut (subtile) ; augmentez-la pour tester si l'amincissement est trop faible pour être visible."
          }
        }
      }
    },
    "When disabled, Agent requires confirmation before executing multi-step plans.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When disabled, Agent requires confirmation before executing multi-step plans."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Agent 执行多步骤计划前会要求确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，Agent 執行多步驟計劃前會要求確認。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, el Agente pide confirmación antes de ejecutar planes de varios pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est désactivé, l'Agent demande une confirmation avant d'exécuter des plans multi-étapes."
          }
        }
      }
    },
