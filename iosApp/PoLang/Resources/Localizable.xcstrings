    "iOS supports Florence-2 only. Qwen3-VL tagging is unavailable on iOS; selecting it falls back to Florence-2.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS supports Florence-2 only. Qwen3-VL tagging is unavailable on iOS; selecting it falls back to Florence-2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 仅支持 Florence-2。Qwen3-VL 打标在 iOS 不可用，选择后回退到 Florence-2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 僅支援 Florence-2。Qwen3-VL 打標在 iOS 不可用，選擇後回退到 Florence-2。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS solo es compatible con Florence-2. El etiquetado con Qwen3-VL no está disponible en iOS; si lo seleccionas, se usará Florence-2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne prend en charge que Florence-2. L'étiquetage Qwen3-VL n'est pas disponible sur iOS ; le sélectionner revient à utiliser Florence-2."
          }
        }
      }
    },
    "iOS uses a single fixed pipeline (CPU only). Per-stage models, GPU and interval profiles are not configurable on iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS uses a single fixed pipeline (CPU only). Per-stage models, GPU and interval profiles are not configurable on iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 使用固定单一管线（仅 CPU），不支持阶段独立模型、GPU 与间隔档位配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 使用固定單一管線（僅 CPU），不支援階段獨立模型、GPU 與間隔檔位配置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS usa un único flujo de procesamiento fijo (solo CPU). Los modelos por etapa, la GPU y los perfiles de intervalo no son configurables en iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS utilise un pipeline unique et fixe (CPU uniquement). Les modèles par étape, le GPU et les profils d'intervalle ne sont pas configurables sur iOS."
          }
        }
      }
    },
