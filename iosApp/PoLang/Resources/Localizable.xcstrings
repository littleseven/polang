    "API Key is stored only on this device and never uploaded to our servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key is stored only on this device and never uploaded to our servers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 仅保存在本机，不会上传到我们的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 僅儲存在本機，不會上傳到我們的伺服器"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de API se guarda solo en este dispositivo y nunca se sube a nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API est stockée uniquement sur cet appareil et n'est jamais envoyée à nos serveurs."
          }
        }
      }
