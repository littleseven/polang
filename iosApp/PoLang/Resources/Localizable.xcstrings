    "On-device image understanding and search-by-image are not available in this version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device image understanding and search-by-image are not available in this version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版暂不支持端侧图像理解与以图搜图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本版暫不支援端側圖像理解與以圖搜圖。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprensión de imágenes en el dispositivo y la búsqueda por imagen no están disponibles en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compréhension d'images sur l'appareil et la recherche par image ne sont pas disponibles dans cette version."
          }
        }
      }
    },
    "On-device voice recognition (ASR) and wake word (KWS) are not yet implemented on iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device voice recognition (ASR) and wake word (KWS) are not yet implemented on iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 尚未实现端侧语音识别（ASR）与唤醒词（KWS）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 尚未實作端側語音辨識（ASR）與喚醒詞（KWS）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en el dispositivo (ASR) y la palabra de activación (KWS) aún no están implementados en iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale sur l'appareil (ASR) et le mot-clé d'activation (KWS) ne sont pas encore implémentés sur iOS."
          }
        }
      }
    },
    "On-device voice recognition (ASR) and wake word (KWS) are not yet implemented on iOS. Settings below are placeholders for future versions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device voice recognition (ASR) and wake word (KWS) are not yet implemented on iOS. Settings below are placeholders for future versions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 尚未实现端侧语音识别（ASR）与唤醒词（KWS），以下设置为后续版本占位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 尚未實作端側語音辨識（ASR）與喚醒詞（KWS），以下設定為後續版本佔位。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en el dispositivo (ASR) y la palabra de activación (KWS) aún no están implementados en iOS. Los ajustes siguientes son marcadores de posición para futuras versiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale sur l'appareil (ASR) et le mot-clé d'activation (KWS) ne sont pas encore implémentés sur iOS. Les réglages ci-dessous sont des espaces réservés pour les futures versions."
          }
        }
      }
    },
    "On: replace existing results. Off: fill in missing only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: replace existing results. Off: fill in missing only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启：替换已有结果。关闭：仅补齐缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟：替換已有結果。關閉：僅補齊缺失。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: reemplaza los resultados existentes. Desactivado: rellena solo los que falten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : remplace les résultats existants. Désactivé : complète uniquement les manquants."
          }
        }
      }
    },
    "Only gates Agent (Kotlin-side) log output.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only gates Agent (Kotlin-side) log output."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅门控 Agent（Kotlin 侧）日志输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅門控 Agent（Kotlin 側）日誌輸出。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo controla la salida de registros del Agent (lado Kotlin)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne filtre que les journaux de l'Agent (côté Kotlin)."
          }
        }
      }
    },
    "Only this chat can send commands (security whitelist). Without Chat ID, the bot rejects all messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this chat can send commands (security whitelist). Without Chat ID, the bot rejects all messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅该聊天可下发指令（安全白名单）。未填写「允许的 Chat ID」时，为安全起见机器人将拒绝所有消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅該聊天可下發指令（安全白名單）。未填寫「允許的 Chat ID」時，為安全起見機器人將拒絕所有訊息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este chat puede enviar comandos (lista blanca de seguridad). Sin el ID de chat, el bot rechaza todos los mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule cette discussion peut envoyer des commandes (liste blanche de sécurité). Sans Chat ID, le bot rejette tous les messages."
          }
        }
      }
    },
