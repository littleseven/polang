          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开始重新聚类（仅有人脸，耗时较长），完成后返回本页自动刷新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開始重新聚類（僅有人臉，耗時較長），完成後返回本頁自動整理"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reagrupación iniciada (solo rostros, puede tardar un poco). Vuelve a entrar en esta página para actualizar al terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupement relancé (visages uniquement, cela peut prendre du temps). Rouvrez cette page pour actualiser une fois terminé."
          }
        }
      }
    },
    "Read-only. beauty.hasFace=0 means face points never reach the shader — slim cannot work no matter the strength.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only. beauty.hasFace=0 means face points never reach the shader — slim cannot work no matter the strength."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读。beauty.hasFace=0 表示关键点从未送达 shader——无论强度多大瘦脸都不会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀。beauty.hasFace=0 表示關鍵點從未送達 shader——無論強度多大瘦臉都不會生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura. beauty.hasFace=0 significa que los puntos del rostro nunca llegan al shader — el adelgazamiento no funciona sin importar la intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule. beauty.hasFace=0 signifie que les points du visage n'atteignent jamais le shader — l'affinement ne peut pas fonctionner, quelle que soit l'intensité."
          }
        }
      }
    },
