    "Draw detected face landmarks on the preview to verify detection feeds the renderer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw detected face landmarks on the preview to verify detection feeds the renderer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览上绘制检测到的人脸关键点，验证检测结果是否送达渲染器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在預覽上繪製檢測到的人臉關鍵點，驗證檢測結果是否送達渲染器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja los puntos faciales detectados en la vista previa para comprobar que la detección alimenta al renderizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine les points de repère du visage détectés sur l'aperçu pour vérifier que la détection alimente le moteur de rendu."
          }
        }
      }
    },
